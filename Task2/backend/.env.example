# Copy to .env (or .env.local) and fill in your key. Never commit it.
#
# Only LLM_API_KEY has to be set for the app to run -- everything below it has a
# working default. The three lines marked REQUIRED-ISH should match your provider.

# --- LLM provider -------------------------------------------------------------
# The app speaks the OpenAI Chat Completions format, which several providers
# implement. Switching provider is these four values -- no code change.
#
#   Google Gemini (free tier):
#     LLM_API_KEY=...            from https://aistudio.google.com/apikey
#     LLM_BASE_URL=gemini
#     LLM_CHAT_MODEL=gemini-3.6-flash
#
#   OpenAI:
#     LLM_API_KEY=sk-...
#     LLM_BASE_URL=              (leave empty)
#     LLM_CHAT_MODEL=gpt-5.5

# REQUIRED: nothing works without this.
LLM_API_KEY=
# REQUIRED-ISH: preset name (openai / gemini / groq / together) or a full base URL.
LLM_BASE_URL=gemini
# REQUIRED-ISH: writes the course plans, so use the strongest model you have.
LLM_CHAT_MODEL=gemini-3.6-flash
# REQUIRED-ISH: cheap model for the slot-filling / intent read that opens every
# turn. Defaults to LLM_CHAT_MODEL when empty, which works but costs more.
LLM_CONDENSE_MODEL=gemini-3.5-flash-lite

# --- Sessions and limits ------------------------------------------------------
# How long an idle planning session survives before it is evicted.
SESSION_TTL_MINUTES=180
# Hard cap on concurrent sessions; the least recently used is dropped past this.
MAX_SESSIONS=200
# Turns of conversation sent back to the model as context.
MAX_HISTORY_MESSAGES=24
# Ceilings on a generated plan. They keep one generation inside a sane token
# budget; the model is told to use fewer when the course is shorter.
MAX_MODULES=12
MAX_LESSONS_PER_MODULE=8

# --- Syllabus import (bonus) --------------------------------------------------
# Largest PDF accepted by POST /api/sessions/{id}/syllabus.
MAX_UPLOAD_MB=10
# Extracted syllabus text is truncated to this before it reaches the model.
MAX_SYLLABUS_CHARS=40000

# --- Resource link verification -----------------------------------------------
# Every resource URL in a plan is fetched before the mentor sees it, and the badge
# on the row reports the result. Set to false for a demo with no network: links
# then stay honestly labelled "unchecked" instead of failing.
VERIFY_RESOURCE_LINKS=true
# Per-link timeout. Short on purpose -- a slow host must not slow down a turn.
LINK_CHECK_TIMEOUT_SECONDS=6
# How many links are checked at once.
LINK_CHECK_CONCURRENCY=8

# --- CORS ---------------------------------------------------------------------
# Where the Next.js frontend is served from.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
