# Copy to .env and fill in your key. Never commit .env.

# --- Required -----------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Models -------------------------------------------------------------------
# Verify these against your account:  python scripts/check_models.py
OPENAI_CHAT_MODEL=gpt-5.5
# Cheaper model for rewriting follow-up questions. Defaults to OPENAI_CHAT_MODEL.
OPENAI_CONDENSE_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_BATCH_SIZE=96

# --- Chunking -----------------------------------------------------------------
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# --- Retrieval ----------------------------------------------------------------
RETRIEVAL_TOP_K=8
CONTEXT_CHAR_BUDGET=12000
MAX_CHUNKS_PER_SOURCE=4
# Out-of-scope floor. Lower = more willing to attempt an answer.
MIN_VECTOR_SCORE=0.18

# --- Sessions and limits ------------------------------------------------------
SESSION_TTL_MINUTES=120
MAX_HISTORY_MESSAGES=12
MAX_SOURCES_PER_SESSION=8
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
REQUEST_TIMEOUT_SECONDS=15

# --- Feature flags ------------------------------------------------------------
# Audio transcription for caption-less YouTube videos. Requires ffmpeg + yt-dlp.
ENABLE_AUDIO_FALLBACK=false

# --- CORS ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
