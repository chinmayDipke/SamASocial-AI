# Copy to .env (or .env.local) and fill in your key. Never commit it.

# --- LLM provider -------------------------------------------------------------
# The app speaks the OpenAI Chat Completions format, which several providers
# implement. Switching provider is these four values -- no code change.
#
#   Google Gemini (free tier):
#     LLM_API_KEY=...            from https://aistudio.google.com/apikey
#     LLM_BASE_URL=gemini
#     LLM_CHAT_MODEL=gemini-3.6-flash
#     LLM_EMBED_MODEL=gemini-embedding-001
#
#   OpenAI:
#     LLM_API_KEY=sk-...
#     LLM_BASE_URL=              (leave empty)
#     LLM_CHAT_MODEL=gpt-5.5
#     LLM_EMBED_MODEL=text-embedding-3-small
#
# Confirm your key and models with:  python scripts/check_models.py

LLM_API_KEY=
# Preset name (openai / gemini / groq / together) or a full base URL.
LLM_BASE_URL=gemini
LLM_CHAT_MODEL=gemini-3.6-flash
LLM_EMBED_MODEL=gemini-embedding-001
# Cheaper model for rewriting follow-up questions. Defaults to LLM_CHAT_MODEL.
LLM_CONDENSE_MODEL=gemini-3.5-flash-lite

EMBED_BATCH_SIZE=96
# Some providers cap items per embedding request (Gemini's compat layer: 100).
# 0 means no extra limit beyond EMBED_BATCH_SIZE.
EMBED_MAX_BATCH_ITEMS=0

# --- Chunking -----------------------------------------------------------------
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# --- Retrieval ----------------------------------------------------------------
RETRIEVAL_TOP_K=8
CONTEXT_CHAR_BUDGET=12000
MAX_CHUNKS_PER_SOURCE=4
# Reciprocal-rank-fusion constant used to merge the keyword and vector rankings.
RRF_K=60

# --- Out-of-scope refusal -----------------------------------------------------
# There is no absolute similarity floor: embedding models disagree wildly about
# what an unrelated question scores (measured: ~0.05 on OpenAI vs ~0.48 on
# Gemini for the same question and corpus). Instead the app measures a baseline
# per session by embedding deliberately unrelated probe questions, and a real
# question has to clear that baseline by SCOPE_MARGIN of the remaining headroom.
# Raise it to refuse more, lower it to attempt more.
SCOPE_MARGIN=0.15
# Escape hatch: if this fraction of the question's content words appear anywhere
# in the loaded material, treat it as in scope whatever the vectors say.
SCOPE_TERM_COVERAGE=0.5

# --- Sessions and limits ------------------------------------------------------
SESSION_TTL_MINUTES=120
MAX_SESSIONS=200
MAX_HISTORY_MESSAGES=12
MAX_SOURCES_PER_SESSION=8
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
REQUEST_TIMEOUT_SECONDS=15

# --- Feature flags ------------------------------------------------------------
# Audio transcription for caption-less YouTube videos. Requires ffmpeg + yt-dlp.
ENABLE_AUDIO_FALLBACK=false

# --- CORS ---------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
